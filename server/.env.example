PORT=5000
# Database — use DATABASE_URL or individual fields
DATABASE_URL=postgresql://user:password@localhost:5432/bizflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bizflow
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20

# Supabase (see the notes in the repository .env.example)
# On serverless the API should use the pooler; DDL needs a direct or session
# connection, which is what DB_INIT_URL provides.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_POOLER_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DB_INIT_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
# DB_AUTO_INIT=false
# DB_POOL_IDLE_TIMEOUT_MS=1000
# DB_APPLICATION_NAME=bizflow-api
BACKUP_DIR=./backups
BACKUP_TIMEOUT_MS=900000
PGCONNECT_TIMEOUT=10
JWT_SECRET=generate-a-long-random-string-here
NODE_ENV=development

# SMTP Settings (for emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Business Settings
BUSINESS_NAME=Your Business Name
APP_URL=http://localhost:3000

# M-Pesa Settings
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Bank Transfer Details
BANK_DETAILS=Bank: Example Bank, Account: 1234567890

# AI / Gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SMS (optional)
SMS_PROVIDER=log
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# CDN (optional)
CDN_URL=

# VAPID Keys for Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
