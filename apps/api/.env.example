# Database
DATABASE_URL="postgresql://bizflow:bizflow_dev_password@localhost:5432/bizflow"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (generate a strong random string)
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Server
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
WHATSAPP_VERIFY_TOKEN=""

# Google AI
GOOGLE_API_KEY=""

# Supabase (optional - if using Supabase instead of local Postgres)
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
