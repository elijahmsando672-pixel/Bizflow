# Environment variables template for production deployment
# Copy this file to .env and update the values
# DO NOT commit .env to version control!

# ========================================
# CRITICAL SECURITY SETTINGS
# ========================================

# JWT Secret (generate with: openssl rand -base64 64)
# Must be at least 32 characters, keep secret!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bizflow
DB_USER=postgres
DB_PASSWORD=your-secure-postgres-password

# ========================================
# CORS CONFIGURATION
# ========================================
# Comma-separated list of allowed frontend origins (include scheme)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# ========================================
# SMTP SETTINGS (email notifications)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ========================================
# APPLICATION SETTINGS
# ========================================
NODE_ENV=production
BUSINESS_NAME=Your Business Name
APP_URL=https://yourdomain.com

# Frontend Public API URL (used by client to call backend)
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ========================================
# OPTIONAL: DATABASE SSL (Production)
# ========================================
# DB_SSL_REJECT_UNAUTHORIZED=true (set to false for self-signed)
# DB_SSL_CA=/path/to/ca-certificate

# ========================================
# OPTIONAL: PAYMENT INTEGRATIONS
# ========================================
MPESA_SHORTCODE=XXXXXX
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

BANK_DETAILS=Bank: Your Bank, Account: 1234567890

# ========================================
# OPTIONAL: SECURITY REPORTING
# ========================================
# PGP key for security reports
SECURITY_PGP_KEY=https://yourdomain.com/security.asc


