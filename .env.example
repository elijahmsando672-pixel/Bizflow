# Environment variables template for production deployment
# Copy this file to .env and update the values
# DO NOT commit .env to version control!

# ========================================
# CRITICAL SECURITY SETTINGS
# ========================================

# JWT Secret (generate with: openssl rand -base64 64)
# Must be at least 32 characters, keep secret!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production

# Database Configuration
# For Supabase use the connection pooler, not the direct connection: Vercel has no
# IPv6, so db.<project>.supabase.co cannot be reached from a function.
#   Transaction pooler (recommended for the API):  aws-0-<region>.pooler.supabase.com:6543
#   Session pooler (use for DDL and long sessions):  aws-0-<region>.pooler.supabase.com:5432
#   Direct connection (local machine or VPN only):  db.<project>.supabase.co:5432
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bizflow
DB_USER=postgres
DB_PASSWORD=your-secure-postgres-password
DB_SSL=false
# Optional Supabase conveniences. DATABASE_URL wins; these two are only read when
# DATABASE_URL is empty, and DB_INIT_URL is used for schema creation when set.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_POOLER_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DB_INIT_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres

# Pool tuning — serverless defaults are applied automatically when VERCEL is set
# DB_POOL_MAX=1
# DB_POOL_IDLE_TIMEOUT_MS=1000
# DB_CONNECT_TIMEOUT_MS=10000
# DB_APPLICATION_NAME=bizflow-api
# DB_AUTO_INIT=false   # skip the schema bootstrap on boot (recommended on Vercel)

# ========================================
# CORS CONFIGURATION
# ========================================
# Comma-separated list of allowed frontend origins (include scheme)
# For production: set to your Vercel/Netlify frontend URL(s)
# Example: CORS_ORIGINS=https://bizflow.vercel.app,https://bizflow.netlify.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://YOUR_VERCEL_APP.vercel.app

# ========================================
# SMTP SETTINGS (email notifications)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ========================================
# APPLICATION SETTINGS
# ========================================
NODE_ENV=production
BUSINESS_NAME=Your Business Name
APP_URL=https://YOUR_VERCEL_APP.vercel.app

# Frontend Public API URL (used by client to call backend)
# On Vercel the API is a function on the same origin, so /api is correct and
# credentials + cookies work without CORS.
NEXT_PUBLIC_API_URL=/api

# ========================================
# OPTIONAL: DATABASE SSL (Production)
# Supabase turns TLS on automatically, so nothing is needed for it. Supabase
# certificates are not chained to a public root, which is why certificate
# verification defaults to off for Supabase hosts only.
# ========================================
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false (set to false for self-signed)
# DB_SSL_CA=/path/to/ca-certificate

# ========================================
# OPTIONAL: DATABASE BACKUPS
# ========================================
# Requires the PostgreSQL client (pg_dump) on PATH
# BACKUP_DIR=/app/backups
# BACKUP_TIMEOUT_MS=900000
# PGCONNECT_TIMEOUT=10

# ========================================
# OPTIONAL: AI / GEMINI INTEGRATION
# ========================================
# Server-side AI (Express): GEMINI_API_KEY
# NestJS API server-side: GOOGLE_API_KEY
# Client-side (Web app): NEXT_PUBLIC_GOOGLE_API_KEY (exposed to browser)
# For production, set all three to the same key
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
NEXT_PUBLIC_GOOGLE_API_KEY=your-gemini-api-key

# ========================================
# OPTIONAL: PAYMENT INTEGRATIONS
# ========================================
MPESA_SHORTCODE=XXXXXX
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

# ========================================
# OPTIONAL: SECURITY REPORTING
# ========================================
# PGP key for security reports
SECURITY_PGP_KEY=https://yourdomain.com/security.asc


