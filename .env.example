# Environment variables template for production deployment
# Copy this file to .env and update the values
# DO NOT commit .env to version control!

# ========================================
# CRITICAL SECURITY SETTINGS
# ========================================

# JWT Secret (generate with: openssl rand -base64 64)
# Must be at least 32 characters, keep secret!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production

# Database Configuration
# For Supabase use the connection pooler, not the direct connection: Vercel has no
# IPv6, so db.<project>.supabase.co cannot be reached from a function.
#   Transaction pooler (recommended for the API):  aws-0-<region>.pooler.supabase.com:6543
#   Session pooler (use for DDL and long sessions):  aws-0-<region>.pooler.supabase.com:5432
#   Direct connection (local machine or VPN only):  db.<project>.supabase.co:5432
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bizflow
DB_USER=postgres
DB_PASSWORD=your-secure-postgres-password
DB_SSL=false
# Supabase shorthands, used only when DB_HOST is empty. For Supabase prefer the
# connection pooler over the direct connection: Vercel has no IPv6, so
# db.<project>.supabase.co cannot be reached from a function. DB_INIT_URL is used
# for schema creation when set.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_POOLER_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DB_INIT_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres

# Pool tuning — serverless defaults are applied automatically when VERCEL is set
# DB_POOL_MAX=1
# DB_POOL_IDLE_TIMEOUT_MS=1000
# DB_CONNECT_TIMEOUT_MS=10000
# DB_APPLICATION_NAME=bizflow-api
# DB_AUTO_INIT=false   # skip the schema bootstrap on boot (recommended on Vercel)

# ========================================
# SHARED RATE LIMIT STORE
# Auth rate limits (5 attempts / 15 min) are the ones that matter, and an
# in-memory counter is per process. On Vercel that means one budget per warm
# instance, which an attacker defeats by spreading requests across them. Set both
# values to make login, refresh and password-reset limits shared across instances;
# the API warns at boot if a production serverless host has neither set.
# Free Redis: https://console.upstash.com
# ========================================
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ========================================
# CORS CONFIGURATION
# ========================================
# Comma-separated list of allowed frontend origins (include scheme)
# For production: set to your Vercel/Netlify frontend URL(s)
# Example: CORS_ORIGINS=https://bizflow.vercel.app,https://bizflow.netlify.app
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://YOUR_VERCEL_APP.vercel.app
# Set CORS_ALLOW_ALL=true only to accept any origin in production. It disables
# the allowlist entirely, so it is a debugging aid, not a deployment setting.
# CORS_ALLOW_ALL=false

# ========================================
# SMTP SETTINGS (email notifications)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ========================================
# APPLICATION SETTINGS
# ========================================
NODE_ENV=production
BUSINESS_NAME=Your Business Name
APP_URL=https://YOUR_VERCEL_APP.vercel.app

# Frontend Public API URL (used by client to call backend)
# On Vercel the API is a function on the same origin, so /api is correct and
# credentials + cookies work without CORS.
NEXT_PUBLIC_API_URL=/api
# Absolute origin of the public site. Consumed by robots.ts/sitemap.ts; without
# it they fall back to the API URL and advertise the backend as the site root.
NEXT_PUBLIC_SITE_URL=https://YOUR_VERCEL_APP.vercel.app

# ========================================
# CAPTCHA (Cloudflare Turnstile)
# ========================================
# Optional. With no secret the sign-in CAPTCHA is a no-op, so a public
# deployment should set both. The site key is public and safe to expose.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ========================================
# OAUTH SIGN-IN (Google / Apple / Microsoft)
# ========================================
# Optional. Each provider only registers when its credentials are all present,
# so a partial block leaves that provider's button failing. The redirect URI to
# register with the provider is ${APP_URL}/auth/<provider>/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# ========================================
# DATABASE SSL
# Supabase turns TLS on automatically, so nothing is needed to encrypt. Verifying
# the certificate does need one extra step: Supabase's cert is not chained to a
# public root, so its own CA must be pinned.
#
# Download prod-ca-2021.crt from Supabase Dashboard > Database > SSL Configuration,
# then set DB_SSL_CA_PEM to the file's contents. Verification is then on and the
# API refuses to boot in production without it.
# ========================================
# DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_SSL_CA=/path/to/prod-ca-2021.crt   (instead of PEM text, on a host with a filesystem)
# DB_SSL_REJECT_UNAUTHORIZED=false      (escape hatch: encrypt only, no verification)

# ========================================
# OPTIONAL: DATABASE BACKUPS
# ========================================
# Requires the PostgreSQL client (pg_dump) on PATH
# BACKUP_DIR=/app/backups
# BACKUP_TIMEOUT_MS=900000
# PGCONNECT_TIMEOUT=10

# ========================================
# OPTIONAL: AI / GEMINI INTEGRATION
# ========================================
# Server-side AI. GEMINI_API_KEY is read first, GOOGLE_API_KEY is the fallback.
# Unset means the AI routes serve static fallback insights.
GEMINI_API_KEY=your-gemini-api-key

# ========================================
# OPTIONAL: PAYMENT INTEGRATIONS
# ========================================
MPESA_SHORTCODE=XXXXXX
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

# ========================================
# OPTIONAL: STATIC ASSET STORAGE
# ========================================
# Base URL that uploaded logos and generated files are served from. When unset
# the app falls back to APP_URL.
# CDN_URL=

# Where uploaded images are written. Defaults to <cwd>/uploads.
# UPLOAD_DIR=/app/uploads

# ========================================
# OPTIONAL: SECURITY REPORTING
# ========================================
# PGP key for security reports
SECURITY_PGP_KEY=https://yourdomain.com/security.asc


