{
  "framework": "nextjs",
  "buildCommand": "NEXT_PUBLIC_API_URL=/api npm --prefix client run build",
  "installCommand": "npm install",
  "outputDirectory": "client/.next",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index"
    }
  ]
}
